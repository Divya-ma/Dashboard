# ==============================================================================
# Crude Oil Risk Manager - Environment Configuration Template
# Copy this file to ".env" and fill in real values. Never commit the real ".env".
# ==============================================================================

# ---------- App ----------
APP_HOST=0.0.0.0
APP_PORT=8050
APP_DEBUG=False
APP_TITLE=Crude Oil Risk Manager

# ---------- Access control (HTTP Basic Auth) ----------
# Empty = no login screen. This is fine if the dashboard is only ever reached
# from localhost on this machine. Set BOTH before opening it up to another PC
# (a LAN firewall rule, a Tailscale network, a reverse proxy, etc.) — otherwise
# anyone who can reach the address sees all positions, P&L and alert settings.
# SENSITIVE
AUTH_USERNAME=
# SENSITIVE
AUTH_PASSWORD=
# Optional: fixes the Flask session secret across restarts (any long random
# string). Leaving it empty just means everyone is logged out on restart.
# SENSITIVE
AUTH_SECRET_KEY=

# ---------- Database ----------
DB_PATH=db/crude_oil_risk.db

# ---------- Historical data storage ----------
HISTORICAL_DATA_DIR=data/historical

# ---------- Correlation tab: manual Excel fallback uploads ----------
CORRELATION_UPLOADS_DIR=data/correlation_uploads

# ---------- Live data adapter ----------
# SENSITIVE: base URL of the live market data vendor API
LIVE_API_BASE_URL=
# SENSITIVE: authentication token for the live market data vendor
LIVE_API_TOKEN=
LIVE_POLL_INTERVAL_SECONDS=2.0
LIVE_STALENESS_THRESHOLD_SECONDS=10.0

# ---------- Historical data adapter ----------
# SENSITIVE: base URL of the historical market data vendor API
HISTORICAL_API_BASE_URL=
# SENSITIVE: authentication token for the historical market data vendor
HISTORICAL_API_TOKEN=
HISTORICAL_API_CALLS_PER_MINUTE=7

# ---------- Alerts: in-app ----------
ALERT_PORTFOLIO_PNL_STOP=-50000.0
ALERT_STRUCTURE_MAX_LOSS=-10000.0
ALERT_STALENESS_THRESHOLD_SECONDS=10.0

# ---------- Alerts: Microsoft Teams ----------
# SENSITIVE: incoming webhook URL for the Teams channel that receives alerts
TEAMS_WEBHOOK_URL=
TEAMS_ALERTS_ENABLED=False

# ---------- Risk defaults ----------
DEFAULT_VAR_CONFIDENCE=0.95
DEFAULT_CORRELATION_WINDOW=60
DEFAULT_MARGIN_LIMIT=1000000.0

# ---------- Contract roll warning ----------
ROLL_WARNING_DAYS_BEFORE_EXPIRY=5
